# Copy to wrapped.env and chmod 600: the token is your Navidrome login.
# Navidrome's Subsonic API, used only to download album covers.
ND_URL=http://localhost:4533
ND_USER=your-navidrome-user
# Subsonic token auth: ND_TOKEN = md5(password + ND_SALT), ND_SALT = any random string
ND_TOKEN=
ND_SALT=
# Navidrome's SQLite database (opened read-only)
ND_DB=/path/to/navidrome/data/navidrome.db
# Time zone for "which month" and the listening clock
TZ=UTC
